{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/*.tsbuildinfo"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/shell/src/tui/**"],
      "linter": {
        "rules": {
          "a11y": "off"
        }
      }
    }
  ]
}
