---
import { github, nav } from "../../data/landing"
import Logo from "../Logo.astro"
const base = import.meta.env.BASE_URL
const href = (to: string) => (to.startsWith("#") || to.startsWith("http") ? to : `${base}${to}`)
---

<nav class="nav" aria-label="Main">
  <a class="brand" href={base}><Logo size={22} />Cockpit</a>
  <div class="links">{nav.map((link) => <a href={href(link.href)}>{link.label}</a>)}</div>
  <div class="ctas">
    <a class="btn" href={github}>GitHub ↗</a>
    <a class="btn primary" href="#install">Install</a>
  </div>
</nav>
