---
/**
 * The hook, and nothing else.
 *
 * It used to carry a hand-built mock of the panel on the right — a drawing of the product, beside
 * the product's own recordings and screenshots further down. The real thing is a better argument
 * than an illustration of it, so the space goes to the sentence instead.
 */
import { hero } from "../../data/landing"
---
<header class="page hero">
  <p class="eyebrow mono">{hero.eyebrow}</p>
  <h1>{hero.title[0]} <b>{hero.title[1]}</b> {hero.title[2]}</h1>
  <p class="sub">{hero.body}</p>

  <div class="actions">
    <a class="btn btn-solid btn-lg" href="#install">Install Cockpit</a>
    <a class="btn btn-line btn-lg" href="#bays">See what it does</a>
  </div>

  <div class="cmd mono">
    <span class="sigil">$</span><span data-copy-text>{hero.install}</span>
    <button type="button" data-copy>copy</button>
  </div>
</header>

<style>
  .hero {
    padding-block: 104px 56px;
    display: flex; flex-direction: column; align-items: center; text-align: center;
  }
  .eyebrow { font-size: 12.5px; letter-spacing: 0.06em; color: var(--ck-accent); }
  h1 {
    font-size: clamp(40px, 6.4vw, 78px); line-height: 1.02; margin-top: 22px;
    max-width: 20ch; letter-spacing: -0.03em; text-wrap: balance;
  }
  h1 b { font-weight: 600; position: relative; white-space: nowrap; }
  /* In em, so the mark keeps its proportion to the type instead of shrinking into a stray line. */
  h1 b::after {
    content: ""; position: absolute; left: -0.04em; right: -0.04em; bottom: 0.04em; height: 0.16em;
    background: var(--ck-accent-soft); border-bottom: 0.035em solid var(--ck-accent); z-index: -1;
  }
  .sub {
    margin-top: 26px; color: var(--ck-fg-2); font-size: 18.5px; line-height: 1.62;
    max-width: 62ch; text-wrap: pretty;
  }
  .actions { margin-top: 36px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .cmd {
    margin-top: 22px; display: inline-flex; align-items: center; gap: 12px; font-size: 13.5px;
    color: var(--ck-fg-2); border: 1px dashed var(--ck-line-2); border-radius: var(--ck-radius-sm);
    padding: 10px 14px;
  }
  .cmd .sigil { color: var(--ck-accent); }
  .cmd button { background: none; border: 0; color: var(--ck-fg-3); font: inherit; font-size: 12.5px; cursor: pointer; }
  .cmd button:hover { color: var(--ck-fg); }
  @media (max-width: 940px) { .hero { padding-block: 60px 34px; } }
</style>

<script>
  // One copy handler for every command on the page.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const text = button.parentElement?.querySelector<HTMLElement>("[data-copy-text]")?.textContent
      if (!text) return
      await navigator.clipboard.writeText(text.trim())
      const was = button.textContent
      button.textContent = "copied"
      setTimeout(() => { button.textContent = was }, 1400)
    })
  }
</script>
