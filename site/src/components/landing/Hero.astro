---
import { bays, hero } from "../../data/landing"
import Install from "./Install.astro"
---

<section class="hero">
  <div class="tag"><i></i>{hero.tag}</div>
  <h1>{hero.title}<span>{hero.accent}</span></h1>
  <p class="sub">{hero.body}</p>
  <Install />
  <div class="hero-links"><a class="btn" href="#trail">See Trail ↓</a><a class="btn" href="#bays">Every bay</a></div>

  <div class="deck">
    <span class="plus tl"></span><span class="plus tr"></span><span class="plus bl"></span><span class="plus br"></span>
    <div class="window live" aria-label="A scripted OpenCode session with Cockpit's sidebar, drawn by Cockpit's own code">
      <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i><span>opencode — opencode-cockpit · Fix the bundle desync</span></div>
      <div class="panes">
        <div class="chat" id="hero-chat"></div>
        <aside class="side">
          <div class="block" id="b-shell"><div class="term" id="hero-shell"></div></div>
          <div class="block" id="b-sub"><div class="term" id="hero-sub"></div></div>
          <div class="block" id="b-trail"><div class="term" id="hero-trail"></div></div>
        </aside>
      </div>
      <div class="statusline" id="b-status">
        <span>build · claude-opus</span><span class="gauge"><b id="hero-gauge"></b></span><span id="hero-ctx">12%</span><span class="working" id="hero-work">working 0s</span>
      </div>
    </div>
    <!-- placed beside their blocks by the script, which knows where the blocks are -->
    <div class="callout r" id="c-shell" data-for="b-shell"><b>SHELLS</b> background runs</div>
    <div class="callout r" id="c-sub" data-for="b-sub"><b>SUBAGENTS</b> helpers, live</div>
    <div class="callout r" id="c-trail" data-for="b-trail"><b>TRAIL</b> what it made</div>
    <div class="callout l" id="c-chat" data-for="hero-chat">the conversation <b>OPENCODE</b></div>
    <div class="callout l" id="c-status" data-for="b-status">context, filling <b>STATUS</b></div>
  </div>
  <p class="proof">{hero.proof}</p>

  <div class="bays" id="bays">
    {bays.map((bay) => <a class="bay" href={`#${bay.id}`} data-bay={bay.id}>{bay.name}<small>{bay.what}</small></a>)}
  </div>
</section>
