---
import { hero } from "../../data/landing"
---
<header class="page hero">
  <div>
    <p class="eyebrow mono">{hero.eyebrow}</p>
    <h1>{hero.title[0]} <b>{hero.title[1]}</b>{hero.title[2]}</h1>
    <p class="sub">{hero.body}</p>
    <div class="actions">
      <a class="btn btn-solid btn-lg" href="#install">Install Cockpit</a>
      <a class="btn btn-line btn-lg" href="#demo">Watch a session</a>
    </div>
    <div class="cmd mono">
      <span class="sigil">$</span><span data-copy-text>{hero.install}</span>
      <button type="button" data-copy>copy</button>
    </div>
  </div>

  <div class="deck">
    <div class="deck-cap mono">
      {hero.deck.caption}<span class="live"><i></i> live</span>
    </div>
    {hero.deck.slots.map((s) => (
      <div class:list={["slot", s.state]}>
        <span class="badge mono">{s.state === "warn" ? "fail" : "run"}</span>
        <span class="name">{s.name} <em class="mono">{s.detail}</em></span>
        <span class="meta mono">{s.meta}</span>
      </div>
    ))}
    <div class="out mono" data-lines={JSON.stringify(hero.deck.lines)}></div>
  </div>
</header>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: 64px; padding-block: 88px 40px; align-items: start; }
  .eyebrow { font-size: 12.5px; letter-spacing: 0.06em; color: var(--ck-accent); }
  h1 { font-size: clamp(42px, 5vw, 60px); line-height: 1.04; margin-top: 20px; }
  h1 b { font-weight: 600; position: relative; white-space: nowrap; }
  h1 b::after { content: ""; position: absolute; left: 0; right: 0; bottom: 6px; height: 10px; background: var(--ck-accent-soft); border-bottom: 2px solid var(--ck-accent); z-index: -1; }
  .sub { margin-top: 24px; color: var(--ck-fg-2); font-size: 18px; line-height: 1.66; max-width: 48ch; }
  .actions { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; }
  .cmd { margin-top: 20px; display: inline-flex; align-items: center; gap: 12px; font-size: 13.5px; color: var(--ck-fg-2); border: 1px dashed var(--ck-line-2); border-radius: var(--ck-radius-sm); padding: 10px 14px; }
  .cmd .sigil { color: var(--ck-accent); }
  .cmd button { background: none; border: 0; color: var(--ck-fg-3); font: inherit; font-size: 12.5px; cursor: pointer; }
  .cmd button:hover { color: var(--ck-fg); }

  .deck { background: var(--ck-card); border: 1px solid var(--ck-line); border-radius: var(--ck-radius); overflow: hidden; }
  .deck-cap { display: flex; align-items: center; gap: 10px; padding: 13px 16px; border-bottom: 1px solid var(--ck-line); font-size: 12px; color: var(--ck-fg-3); letter-spacing: 0.04em; }
  .live { margin-left: auto; display: inline-flex; align-items: center; gap: 7px; color: var(--ck-accent); }
  .live i { width: 6px; height: 6px; border-radius: 50%; background: var(--ck-accent); }
  @media (prefers-reduced-motion: no-preference) { .live i { animation: pulse 2.6s ease-in-out infinite; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  .slot { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 14px 16px; border-bottom: 1px solid var(--ck-line); }
  .badge { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 6px; padding: 4px 8px; border: 1px solid var(--ck-line-2); color: var(--ck-fg-3); }
  .slot.run .badge { color: var(--ck-accent); border-color: color-mix(in srgb, var(--ck-accent) 40%, transparent); background: var(--ck-accent-soft); }
  .slot.warn .badge { color: var(--ck-warn); border-color: color-mix(in srgb, var(--ck-warn) 40%, transparent); background: color-mix(in srgb, var(--ck-warn) 10%, transparent); }
  .name { font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .name em { font-style: normal; color: var(--ck-fg-3); font-size: 12.5px; }
  .meta { font-size: 12px; color: var(--ck-fg-3); font-variant-numeric: tabular-nums; }

  .out { padding: 15px 16px 17px; font-size: 12.5px; line-height: 1.8; color: var(--ck-fg-2); min-height: 150px; white-space: pre-wrap; background: var(--ck-bg-2); }
  @media (max-width: 940px) { .hero { grid-template-columns: 1fr; gap: 38px; padding-block: 52px 28px; } }
</style>

<style is:global>
  .out .a { color: var(--ck-accent); }
  .out .b { color: var(--ck-info); }
  .out .w { color: var(--ck-warn); }
  .out .d { color: var(--ck-fg-3); }
  .out .caret { display: inline-block; width: 7px; height: 14px; background: var(--ck-fg-2); vertical-align: -2px; }
  @media (prefers-reduced-motion: no-preference) {
    .out .caret { animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  }
</style>

<script>
  // The deck types its last few lines, so the first thing on the page is the product moving.
  const out = document.querySelector<HTMLElement>(".out")
  if (out) {
    const lines: string[] = JSON.parse(out.dataset.lines ?? "[]")
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    const render = (n: number) => {
      out.innerHTML = lines.slice(0, n).map((l) => `<div>${l || "&nbsp;"}</div>`).join("") +
        '<div><span class="caret"></span></div>'
    }
    if (reduced) render(lines.length)
    else {
      let i = 0
      const next = () => { render(++i); if (i < lines.length) setTimeout(next, lines[i - 1] ? 520 : 160) }
      setTimeout(next, 500)
    }
  }

  // One copy handler for every command on the page.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.parentElement?.querySelector("[data-copy-text]")?.textContent?.trim() ?? ""
      try { await navigator.clipboard.writeText(text); btn.textContent = "copied" }
      catch { btn.textContent = "⌘C" }
      setTimeout(() => { btn.textContent = "copy" }, 1500)
    })
  })
</script>
