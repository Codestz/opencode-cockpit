---
import SectionHead from "./SectionHead.astro"
import { bays } from "../../data/landing"
---
<section class="page section" id="bays" style="padding-top:0">
  <SectionHead number={bays.number} kicker={bays.kicker} title={bays.title} intro={bays.intro} />

  <div class="switch">
    <div class="list" role="tablist" aria-label="Capability bays">
      {bays.items.map((b, i) => (
        <button class:list={["pick", b.state]} role="tab" aria-selected={i === 0} data-bay={b.id} type="button">
          <span><b>{b.name}</b><small>{b.tagline}</small></span><span class="dot"></span>
        </button>
      ))}
    </div>

    <div class="panels">
      {bays.items.map((b, i) => (
        <article class="surface panel" data-panel={b.id} hidden={i !== 0}>
          <h3>{b.name}</h3>
          <p class="blurb">{b.blurb}</p>
          <ul>{b.points.map((p) => <li><i class="mono">→</i><span>{p}</span></li>)}</ul>
          <div class="foot mono">
            {b.foot.map((f) => <span>{f}</span>)}
            <span class="status">{b.status}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .switch { margin-top: 40px; display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 24px; align-items: start; }
  .list { display: flex; flex-direction: column; gap: 8px; }
  .pick {
    display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; text-align: left;
    background: none; border: 1px solid var(--ck-line); border-radius: 11px; padding: 15px 16px;
    cursor: pointer; font: inherit; color: var(--ck-fg-2); transition: 0.15s ease;
  }
  .pick:hover { border-color: var(--ck-line-2); color: var(--ck-fg); }
  .pick[aria-selected="true"] { background: var(--ck-card); border-color: var(--ck-accent); color: var(--ck-fg); }
  .pick b { display: block; font-family: var(--ck-font-display); font-size: 16px; font-weight: 600; letter-spacing: -0.02em; }
  .pick small { display: block; color: var(--ck-fg-3); font-size: 12.5px; margin-top: 2px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ck-fg-3); }
  .pick.live .dot { background: var(--ck-accent); }
  .pick.next .dot { background: var(--ck-info); }

  .panel { padding: 28px 30px; min-height: 290px; }
  .panel h3 { font-size: 22px; }
  .blurb { margin-top: 12px; color: var(--ck-fg-2); font-size: 15.5px; max-width: 62ch; }
  ul { margin: 22px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 26px; }
  li { display: grid; grid-template-columns: 16px 1fr; gap: 10px; font-size: 14.5px; color: var(--ck-fg-2); }
  li i { font-style: normal; color: var(--ck-accent); font-size: 12px; padding-top: 3px; }
  .foot { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--ck-line); display: flex; gap: 18px; flex-wrap: wrap; font-size: 12.5px; color: var(--ck-fg-3); }
  .foot .status { margin-left: auto; }
  @media (max-width: 940px) { .switch { grid-template-columns: 1fr; } ul { grid-template-columns: 1fr; } }
</style>

<script>
  const picks = document.querySelectorAll<HTMLButtonElement>(".pick")
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]")
  picks.forEach((pick) => {
    pick.addEventListener("click", () => {
      picks.forEach((p) => p.setAttribute("aria-selected", String(p === pick)))
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== pick.dataset.bay })
    })
  })
</script>
