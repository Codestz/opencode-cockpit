---
/**
 * Comparison tool, not a feature: append ?palettes to any URL to flip the site between candidate
 * palettes. It renders nothing unless asked for, and the chosen one sticks while you browse.
 */
import "../styles/palettes.css"

const palettes = [
  { id: "aqua", label: "Aqua", note: "current" },
  { id: "ion", label: "Ion", note: "electric blue" },
  { id: "ember", label: "Ember", note: "instrument amber" },
  { id: "signal", label: "Signal", note: "acid lime" },
  { id: "coral", label: "Coral", note: "warm coral" },
  { id: "paper", label: "Paper", note: "light" },
]
---

<div class="switcher" hidden data-switcher>
  <span class="title">Palette</span>
  {palettes.map((p) => (
    <button type="button" data-palette-id={p.id}>
      <i style={`background: var(--sw-${p.id})`}></i>
      <span>{p.label}</span>
      <small>{p.note}</small>
    </button>
  ))}
</div>

<style>
  .switcher {
    position: fixed; right: 18px; bottom: 18px; z-index: 90; width: 210px;
    background: var(--ck-card); border: 1px solid var(--ck-line-2); border-radius: var(--ck-radius);
    padding: 12px; display: flex; flex-direction: column; gap: 4px;
    box-shadow: 0 24px 60px -40px #000;
  }
  .title {
    font-family: var(--ck-font-mono); font-size: 10.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ck-fg-3); padding: 2px 6px 6px;
  }
  button {
    display: grid; grid-template-columns: 14px 1fr auto; gap: 10px; align-items: center;
    background: none; border: 1px solid transparent; border-radius: 8px; padding: 7px 8px;
    font: inherit; font-size: 13.5px; color: var(--ck-fg-2); cursor: pointer; text-align: left;
  }
  button:hover { border-color: var(--ck-line-2); color: var(--ck-fg); }
  button[aria-pressed="true"] { border-color: var(--ck-accent); color: var(--ck-fg); background: var(--ck-accent-soft); }
  i { width: 14px; height: 14px; border-radius: 4px; border: 1px solid var(--ck-line-2); }
  small { font-family: var(--ck-font-mono); font-size: 10.5px; color: var(--ck-fg-3); }

  /* swatches: the accent of each candidate, so the list reads at a glance */
  .switcher { --sw-aqua: #5fe3c0; --sw-ion: #6aa6ff; --sw-ember: #f0a14e; --sw-signal: #c3f151; --sw-coral: #ff7a66; --sw-paper: #0d7d6a; }
</style>

<script>
  const box = document.querySelector<HTMLElement>("[data-switcher]")
  if (box) {
    const asked = new URLSearchParams(location.search).has("palettes")
    const stored = localStorage.getItem("ck-palette")
    if (asked || stored) {
      box.hidden = !asked
      const apply = (id: string) => {
        document.documentElement.dataset.palette = id
        localStorage.setItem("ck-palette", id)
        box.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.paletteId === id)),
        )
      }
      apply(stored ?? "aqua")
      box.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
        b.addEventListener("click", () => apply(b.dataset.paletteId!)),
      )
    }
  }
</script>
