---
import Base from "../layouts/Base.astro"
import Nav from "../components/landing/Nav.astro"
import Hero from "../components/landing/Hero.astro"
import Specs from "../components/landing/Specs.astro"
import Fitted from "../components/landing/Fitted.astro"
import Bay from "../components/landing/Bay.astro"
import Compare from "../components/landing/Compare.astro"
import Platform from "../components/landing/Platform.astro"
import Next from "../components/landing/Next.astro"
import Install from "../components/landing/Install.astro"
import Closing from "../components/landing/Closing.astro"
---
<Base
  title="Cockpit — instruments for OpenCode"
  description="Instruments for OpenCode: background terminals your agent starts and waits on, and a statusline that tells you what the session is costing. One daemon, one config, a switch per bay."
>
  <Nav />
  <main>
    <Hero />
    <Specs />
    <!-- The index, then a section each. Fitting another bay is an entry in bays.items. -->
    <Fitted />
    <Bay id="review" number="02" />
    <Bay id="shell" number="03" />
    <Compare />
    <Bay id="status" number="04" />
    <Platform />
    <Next />
    <Install />
  </main>
  <Closing />
</Base>
