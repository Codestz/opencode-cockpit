---
import Base from "../layouts/Base.astro"
import Feature from "../components/landing/Feature.astro"
import Final from "../components/landing/Final.astro"
import Hero from "../components/landing/Hero.astro"
import Nav from "../components/landing/Nav.astro"
import Setup from "../components/landing/Setup.astro"
import TrailStory from "../components/landing/TrailStory.astro"
import { features, hero } from "../data/landing"
import "../styles/engine.css"
import "../styles/live.css"
---

<Base title="Cockpit — instruments for OpenCode" description={hero.body}>
  <div class="deck-page">
    <Nav />
    <main>
      <Hero />
      <TrailStory />
      {features.map((feature, i) => <Feature feature={feature} flip={i % 2 === 1} />)}
      <Setup />
      <Final />
    </main>
  </div>
  <script>
    import "../scripts/landing"
  </script>
</Base>
