---
import Base from "../layouts/Base.astro"
import Nav from "../components/landing/Nav.astro"
import Hero from "../components/landing/Hero.astro"
import Specs from "../components/landing/Specs.astro"
import Fitted from "../components/landing/Fitted.astro"
import Bay from "../components/landing/Bay.astro"
import Compare from "../components/landing/Compare.astro"
import Platform from "../components/landing/Platform.astro"
import Next from "../components/landing/Next.astro"
import Install from "../components/landing/Install.astro"
import Closing from "../components/landing/Closing.astro"
---
<Base
  title="Cockpit — instruments for OpenCode"
  description="Instruments for OpenCode: background terminals your agent starts and waits on, a pull request in the terminal, a statusline that tells you what the session is costing, an updater that shows what every plugin is really running, and your subagents made visible. One daemon, one config, a switch per bay."
>
  <Nav />
  <main>
    <Hero />
    <Specs />
    <!--
      The index, then a section each. A new bay is an entry in bays.items AND a <Bay> line here: the
      sections are placed by hand so Compare can sit beside Shell. The Updater shipped with only the
      first half and appeared in the index with no section below it.
    -->
    <Fitted />
    <Bay id="review" number="02" />
    <Bay id="shell" number="03" />
    <Compare />
    <Bay id="status" number="04" />
    <Bay id="updater" number="05" />
    <Bay id="subagents" number="06" />
    <Platform />
    <Next />
    <Install />
  </main>
  <Closing />
</Base>
