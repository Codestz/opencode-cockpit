{
  "name": "opencode-cockpit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "pack:check": "bun scripts/pack-check.ts",
    "version:set": "bun scripts/set-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "typescript": "7.0.2"
  },
  "version": "0.1.3",
  "engines": {
    "bun": ">=1.3.5"
  }
}
