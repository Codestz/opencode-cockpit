{
  "name": "opencode-cockpit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run build && bun test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "check": "bun run build && bun run lint && bun run typecheck && bun test",
    "pack:check": "bun scripts/pack-check.ts",
    "version:set": "bun scripts/set-version.ts",
    "build": "bun scripts/build.ts",
    "smoke:tui": "bun scripts/tui-smoke.ts",
    "release": "bun scripts/release.ts",
    "record": "bun scripts/record.ts"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "6.0.0",
    "babel-preset-solid": "1.9.12",
    "typescript": "7.0.2"
  },
  "version": "0.2.1",
  "engines": {
    "bun": ">=1.3.5"
  }
}
