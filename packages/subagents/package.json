  },
  "dependencies": {
    "@opencode-cockpit/client": "workspace:*",
    "@opencode-ai/plugin": "1.18.31"
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "bin": {
    "opencode-subagents": "./dist/cli/preview.js",
    "subagents": "./dist/cli/preview.js"
  }
