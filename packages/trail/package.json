{
  "name": "@opencode-cockpit/trail",
  "version": "0.11.0",
  "description": "What a conversation made: the PRs, tickets and pages the agent created or changed, kept, ordered and one click away",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/opencode-cockpit.git",
    "directory": "packages/trail"
  },
  "homepage": "https://cockpit.codestz.dev/trail/overview/",
  "bugs": {
    "url": "https://github.com/Codestz/opencode-cockpit/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
