{
  "name": "opencode-cockpit",
  "version": "0.2.1",
  "description": "OpenCode superpowers, all in one: installs every opencode-cockpit feature (Shell today), each can be switched off",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/opencode-cockpit.git",
    "directory": "packages/opencode"
  },
  "homepage": "https://github.com/Codestz/opencode-cockpit#readme",
  "bugs": {
    "url": "https://github.com/Codestz/opencode-cockpit/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pty",
    "shell",
    "background",
    "tui",
    "terminal",
    "agents"
  ],
  "exports": {
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./types/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "engines": {
    "opencode": ">=1.18.0",
    "bun": ">=1.3.5"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-cockpit/shell": "workspace:*",
    "@opencode-ai/plugin": "1.18.31"
  },
  "devDependencies": {
    "@opencode-cockpit/client": "workspace:*"
  }
}
