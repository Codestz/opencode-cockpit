{
  "name": "@opencode-cockpit/shell",
  "version": "0.1.5",
  "description": "Background shells for OpenCode: the agent starts, waits on and drives PTYs; you watch them in a docked TUI panel",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/opencode-cockpit.git",
    "directory": "packages/shell"
  },
  "homepage": "https://github.com/Codestz/opencode-cockpit#readme",
  "bugs": {
    "url": "https://github.com/Codestz/opencode-cockpit/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pty",
    "shell",
    "background",
    "tui",
    "terminal"
  ],
  "exports": {
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./types/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    },
    "./connect": {
      "types": "./types/connect.d.ts",
      "default": "./dist/connect.js"
    }
  },
  "engines": {
    "opencode": ">=1.18.0",
    "bun": ">=1.3.5"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-cockpit/client": "workspace:*",
    "@opencode-cockpit/daemon": "workspace:*",
    "@opencode-cockpit/protocol": "workspace:*",
    "@opencode-ai/plugin": "1.18.31"
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  }
}
