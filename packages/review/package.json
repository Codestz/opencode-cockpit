{
  "name": "@opencode-cockpit/review",
  "version": "0.3.2",
  "description": "A pull request in the terminal: read the diff, hold your notes, send one review",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/opencode-cockpit.git",
    "directory": "packages/review"
  },
  "homepage": "https://github.com/Codestz/opencode-cockpit#readme",
  "bugs": {
    "url": "https://github.com/Codestz/opencode-cockpit/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "review",
    "diff",
    "code-review",
    "tui",
    "terminal"
  ],
  "exports": {
    "./tui": {
      "types": "./types/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    },
    "./frame": {
      "types": "./types/core/frame.d.ts",
      "default": "./dist/core/frame.js"
    }
  },
  "engines": {
    "opencode": ">=1.18.0",
    "bun": ">=1.3.5"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-cockpit/client": "workspace:*",
    "@opencode-ai/plugin": "1.18.31"
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "bin": {
    "opencode-review": "./dist/cli/preview.js",
    "review": "./dist/cli/preview.js"
  }
}
