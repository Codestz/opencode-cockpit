{
  "name": "@opencode-cockpit/client",
  "version": "0.4.3",
  "description": "Auto-spawning, reconnecting, typed client for cockpitd",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/opencode-cockpit.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/Codestz/opencode-cockpit#readme",
  "bugs": {
    "url": "https://github.com/Codestz/opencode-cockpit/issues"
  },
  "keywords": [
    "opencode",
    "client",
    "json-rpc"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./feature": {
      "types": "./types/feature.d.ts",
      "default": "./dist/feature.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-cockpit/protocol": "workspace:*"
  },
  "devDependencies": {
    "@opencode-cockpit/daemon": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.5"
  }
}
