{
  "name": "@opencode-cockpit/client",
  "version": "0.9.0",
  "description": "Auto-spawning, reconnecting, typed client for cockpitd",
  "type": "module",
  "license": "MIT",
  "author": "Codestz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codestz/opencode-cockpit.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/Codestz/opencode-cockpit#readme",
  "bugs": {
    "url": "https://github.com/Codestz/opencode-cockpit/issues"
  },
  "keywords": [
    "opencode",
    "client",
    "json-rpc"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./feature": {
      "types": "./types/feature.d.ts",
      "default": "./dist/feature.js"
    },
    "./host": {
      "types": "./types/opencode/host/index.d.ts",
      "default": "./dist/opencode/host/index.js"
    },
    "./server": {
      "types": "./types/opencode/server.d.ts",
      "default": "./dist/opencode/server.js"
    },
    "./log": {
      "types": "./types/log.d.ts",
      "default": "./dist/log.js"
    },
    "./sidebar": {
      "types": "./types/opencode/sidebar.d.ts",
      "default": "./dist/opencode/sidebar.js"
    },
    "./design": {
      "types": "./types/design.d.ts",
      "default": "./dist/design.js"
    },
    "./settings": {
      "types": "./types/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./catalog": {
      "types": "./types/settings/catalog.d.ts",
      "default": "./dist/settings/catalog.js"
    },
    "./setup": {
      "types": "./types/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    },
    "./brief": {
      "types": "./types/setup/brief.d.ts",
      "default": "./dist/setup/brief.js"
    },
    "./jsonc": {
      "types": "./types/settings/jsonc.d.ts",
      "default": "./dist/settings/jsonc.js"
    },
    "./plugin-entries": {
      "types": "./types/settings/plugin-entries.d.ts",
      "default": "./dist/settings/plugin-entries.js"
    },
    "./opener": {
      "types": "./types/opener.d.ts",
      "default": "./dist/opener.js"
    },
    "./checks": {
      "types": "./types/settings/checks.d.ts",
      "default": "./dist/settings/checks.js"
    },
    "./service": {
      "types": "./types/opencode/service.d.ts",
      "default": "./dist/opencode/service.js"
    }
  },
  "files": [
    "dist",
    "types",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-cockpit/protocol": "workspace:*",
    "@opencode-ai/plugin": "1.18.33"
  },
  "devDependencies": {
    "@opencode-cockpit/daemon": "workspace:*",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "engines": {
    "bun": ">=1.3.5"
  }
}
